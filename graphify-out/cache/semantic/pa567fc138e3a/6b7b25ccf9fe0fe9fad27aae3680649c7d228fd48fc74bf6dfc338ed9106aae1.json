{"nodes": [{"id": "tests_anomaly_acceptance_anomaly_consumption_acceptance", "label": "Anomaly Consumption Acceptance", "file_type": "document", "source_file": "Tests/ANOMALY-ACCEPTANCE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Checked September 6, 2026 against the local Anomaly checkout. GitHub fetches were unavailable, so this validates the local update rather than a published release."}, {"id": "tests_anomaly_acceptance_velocity_convention_15", "label": "Velocity Convention 15", "file_type": "concept", "source_file": "Tests/ANOMALY-ACCEPTANCE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Required convention is exactly 15: unjittered, internal pixel units, Y down, current-to-previous. previousPixel = currentPixel + motion."}, {"id": "tests_anomaly_acceptance_motion_vector_scale", "label": "FRS Motion Vector Scale", "file_type": "concept", "source_file": "Tests/ANOMALY-ACCEPTANCE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FRS motion-vector scale is (+1,+1)."}, {"id": "tests_anomaly_acceptance_legacy_flags_7", "label": "Legacy Flags 7 Fallback", "file_type": "concept", "source_file": "Tests/ANOMALY-ACCEPTANCE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Legacy 7 and unknown flags fall back. Legacy flags 7 must never reach FRS."}, {"id": "tests_anomaly_acceptance_velocityprobe", "label": "VelocityProbe", "file_type": "concept", "source_file": "Tests/ANOMALY-ACCEPTANCE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "VelocityProbe must be readable and Off. Anomaly does not expose producer frame IDs or frame-latched probe state, so freshness across a probe toggle cannot be proved from this API. Keep probes Off for captures."}, {"id": "tests_anomaly_acceptance_catalog_not_velocity_fallback", "label": "Catalog Not Velocity Fallback", "file_type": "rationale", "source_file": "Tests/ANOMALY-ACCEPTANCE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The catalog cannot certify conventions and is no longer a velocity fallback."}, {"id": "tests_anomaly_acceptance_fail_closed", "label": "Fail Closed Probe Metadata", "file_type": "rationale", "source_file": "Tests/ANOMALY-ACCEPTANCE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Missing probe metadata fails closed."}, {"id": "tests_anomaly_acceptance_automated_contract_checks", "label": "Automated Contract Checks", "file_type": "concept", "source_file": "Tests/ANOMALY-ACCEPTANCE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tests_anomaly_acceptance_anomalyacceptance_harness", "label": "AnomalyAcceptance Harness", "file_type": "concept", "source_file": "Tests/ANOMALY-ACCEPTANCE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Links the production reflection consumer and reset policy. Does not exercise D3D, FRS, or certify rendered image quality."}, {"id": "tests_anomaly_acceptance_in_game_acceptance", "label": "In-Game Acceptance", "file_type": "concept", "source_file": "Tests/ANOMALY-ACCEPTANCE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use the same scene, FRS mode, jitter settings and exposure for every comparison. GPU captures of consecutive-frame textures are required; debug colors are not numeric evidence."}, {"id": "tests_anomaly_acceptance_reprojection", "label": "Reprojection Acceptance", "file_type": "concept", "source_file": "Tests/ANOMALY-ACCEPTANCE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For a tracked point moving +3 internal pixels horizontally, require MV=(-3,0). Reproject with currentPixel+MV. Proposed: stationary median error <=0.1 pixel and tracked-point error <=0.5 pixel. Camera-only paths cannot reproduce independent object motion and are a control, not an object-reprojection pass."}, {"id": "tests_anomaly_acceptance_ghosting", "label": "Ghosting Acceptance", "file_type": "concept", "source_file": "Tests/ANOMALY-ACCEPTANCE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Require no persistent duplicate edge after motion stops and no regression on static voxels. Annotate disocclusion/reactive-mask limitations separately. Visual responsiveness alone is not a pass."}, {"id": "tests_anomaly_acceptance_camera_cuts", "label": "Camera Cut Reset", "file_type": "concept", "source_file": "Tests/ANOMALY-ACCEPTANCE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Teleport and rotate abruptly. Require camera-cut or invalid-history reset on the first evaluated post-cut frame, no old-scene history trail, then reset=none. Check AfterUpscale only on success."}, {"id": "tests_anomaly_acceptance_resolution", "label": "Resolution Reset", "file_type": "concept", "source_file": "Tests/ANOMALY-ACCEPTANCE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Require rejection of old-size buffers, a resolution/configuration/history reset, then the new texture identity and matching internal dimensions at FRS. Confirm no stretch-history artifact, crash, or disposal of the producer texture."}, {"id": "tests_anomaly_acceptance_source_probe_changes", "label": "Source and Probe Changes", "file_type": "concept", "source_file": "Tests/ANOMALY-ACCEPTANCE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Require a source reset even when switching between Anomaly modes. Enable each probe and verify explicit camera fallback; turn probes Off and allow producer history to settle before numerical captures."}, {"id": "tests_anomaly_acceptance_binding_evidence", "label": "Binding Evidence", "file_type": "concept", "source_file": "Tests/ANOMALY-ACCEPTANCE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A snapshot of the last submission, not a promise the current registry still matches."}, {"id": "tests_anomaly_acceptance_show_status", "label": "Show Status", "file_type": "concept", "source_file": "Tests/ANOMALY-ACCEPTANCE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Show Status is available in Release; Debug builds also sample evidence in the log."}, {"id": "tests_anomaly_acceptance_gbuffer", "label": "Anomaly GBuffer Velocity", "file_type": "concept", "source_file": "Tests/ANOMALY-ACCEPTANCE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tests_anomaly_acceptance_camera_only", "label": "Anomaly CameraOnly Velocity", "file_type": "concept", "source_file": "Tests/ANOMALY-ACCEPTANCE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Camera-only paths cannot reproduce independent object motion; use as a control rather than expecting object reprojection to pass."}, {"id": "tests_anomaly_acceptance_local_camera_fallback", "label": "Local Camera Fallback", "file_type": "concept", "source_file": "Tests/ANOMALY-ACCEPTANCE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tests_anomaly_acce